-- ==================== VARIABLES ====================
local autoFarm = false
local farmSpeed = 22
local openDelay = 0.6
local maxDistance = 120
local onlyVisible = false

local knownNames = {
    "crate", "box", "chest", "loot", "supply", "container",
    "cache", "drop", "package", "storage", "case", "trunk"
}

-- ==================== HELPERS ====================
local function notify(title, text)
    pcall(function()
        WindUI:Notify({
            Title = title or "Survive Farm",
            Content = text or "",
            Duration = 3
        })
    end)
end

local function isCrate(obj)
    if not obj or not obj:IsA("BasePart") and not obj:IsA("Model") then return false end
    local name = string.lower(obj.Name)
    for _, key in ipairs(knownNames) do
        if string.find(name, key) then return true end
    end
    -- también busca ProximityPrompt o ClickDetector
    if obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildOfClass("ClickDetector") then
        return true
    end
    if obj:IsA("Model") then
        for _, child in ipairs(obj:GetDescendants()) do
            if child:IsA("ProximityPrompt") or child:IsA("ClickDetector") then
                return true
            end
        end
    end
    return false
end

local function getCratePart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function tryOpen(obj)
    -- ProximityPrompt
    local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        pcall(function()
            fireproximityprompt(prompt)
        end)
        return true
    end

    -- ClickDetector
    local click = obj:FindFirstChildOfClass("ClickDetector") or obj:FindFirstChildWhichIsA("ClickDetector", true)
    if click then
        pcall(function()
            fireclickdetector(click)
        end)
        return true
    end

    -- Touch
    local part = getCratePart(obj)
    if part and RootPart then
        pcall(function()
            firetouchinterest(RootPart, part, 0)
            task.wait(0.05)
            firetouchinterest(RootPart, part, 1)
        end)
        return true
    end

    return false
end

local function getNearbyCrates()
    local list = {}
    if not RootPart then return list end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if isCrate(obj) then
            local part = getCratePart(obj)
            if part then
                local dist = (part.Position - RootPart.Position).Magnitude
                if dist <= maxDistance then
                    table.insert(list, {obj = obj, part = part, dist = dist})
                end
            end
        end
    end

    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end


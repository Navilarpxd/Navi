-- Loop del auto farm
task.spawn(function()
    while true do
        if autoFarm and RootPart and Humanoid and Humanoid.Health > 0 then
            local crates = getNearbyCrates()

            if #crates > 0 then
                local target = crates[1]
                local part = target.part

                pcall(function()
                    statusLabel:SetDesc(string.format("Yendo a: %s (%.1fm) | Cajas: %d", target.name, target.dist, #crates))
                end)

                if teleportToCrate and target.dist > 10 then
                    -- Teleport cerca de la caja
                    RootPart.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                    task.wait(0.15)
                else
                    Humanoid.WalkSpeed = farmSpeed
                    Humanoid:MoveTo(part.Position)
                end

                -- Intentar abrir varias veces
                for i = 1, 3 do
                    tryOpen(target.obj)
                    task.wait(0.12)
                end

                task.wait(openDelay)
            else
                pcall(function()
                    statusLabel:SetDesc("No hay cajas cerca... buscando")
                end)
                task.wait(0.8)
            end
        else
            task.wait(0.35)
        end
    end
end)

-- ==================== OBJECT LOGGER (resultados en la UI) ====================
Logger:Section({ Title = "Object Logger", Icon = "search", Opened = true })

local resultsLabel = Logger:Paragraph({
    Title = "Resultados del escaneo",
    Desc = "Presiona ESCANEAR AHORA para ver los objetos aquí mismo."
})

Logger:Button({
    Title = "ESCANEAR AHORA",
    Icon = "search",
    Callback = function()
        local crates = {}
        local count = 0

        for _, obj in ipairs(workspace:GetDescendants()) do
            if isCrate(obj) then
                local part = getCratePart(obj)
                if part then
                    count += 1
                    local dist = RootPart and (part.Position - RootPart.Position).Magnitude or 0
                    table.insert(crates, {
                        name = obj.Name,
                        full = obj:GetFullName(),
                        dist = dist,
                        class = obj.ClassName
                    })
                end
            end
        end

        table.sort(crates, function(a, b) return a.dist < b.dist end)

        -- Mostrar solo los 25 más cercanos en la UI
        local text = "Total encontrados: " .. count .. "\n\n"
        local show = math.min(#crates, 25)

        for i = 1, show do
            local c = crates[i]
            text = text .. string.format("%d. %s  (%.0fm)\n", i, c.name, c.dist)
        end

        if count > 25 then
            text = text .. "\n... y " .. (count - 25) .. " más (mira F9 para todos)"
        end

        pcall(function()
            resultsLabel:SetDesc(text)
        end)

        -- También imprimir en consola
        print("========== OBJECT LOG ==========")
        for i, c in ipairs(crates) do
            print(string.format("[%d] %s | %.1fm | %s", i, c.full, c.dist, c.class))
        end
        print("Total: " .. count)
        print("================================")

        notify("Logger", "Encontrados: " .. count .. " objetos")
    end
})

Logger:Button({
    Title = "LISTAR MODELOS DEL WORKSPACE",

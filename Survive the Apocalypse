-- ==================== HELPERS ====================
local function notify(title, text)
    pcall(function()
        WindUI:Notify({
            Title = title or "Survive Farm",
            Content = text or "",
            Duration = 2.5
        })
    end)
end

local function isCrate(obj)
    if not obj then return false end
    local name = string.lower(obj.Name)

    for _, key in ipairs(knownNames) do
        if string.find(name, key) then return true end
    end

    -- ProximityPrompt o ClickDetector
    if obj:IsA("BasePart") or obj:IsA("Model") then
        if obj:FindFirstChildOfClass("ProximityPrompt") then return true end
        if obj:FindFirstChildOfClass("ClickDetector") then return true end
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
                return true
            end
        end
    end
    return false
end

local function getCratePart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function tryOpen(obj)
    local opened = false

    -- 1. ProximityPrompt
    local prompts = {}
    if obj:IsA("ProximityPrompt") then
        table.insert(prompts, obj)
    end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            table.insert(prompts, d)
        end
    end
    for _, prompt in ipairs(prompts) do
        pcall(function()
            fireproximityprompt(prompt)
            opened = true
        end)
        -- método alternativo
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(0.1)
            prompt:InputHoldEnd()
            opened = true
        end)
    end

    -- 2. ClickDetector
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("ClickDetector") then
            pcall(function()
                fireclickdetector(d)
                opened = true
            end)
        end
    end
    if obj:IsA("ClickDetector") then
        pcall(function()
            fireclickdetector(obj)
            opened = true
        end)
    end

    -- 3. Touch
    local part = getCratePart(obj)
    if part and RootPart then
        pcall(function()
            firetouchinterest(RootPart, part, 0)
            task.wait(0.07)
            firetouchinterest(RootPart, part, 1)
            opened = true
        end)
    end

    return opened
end

local function getNearbyCrates()
    local list = {}
    if not RootPart then return list end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if isCrate(obj) then
            local part = getCratePart(obj)
            if part and part:IsA("BasePart") then
                local dist = (part.Position - RootPart.Position).Magnitude
                if dist <= maxDistance and dist > 1 then
                    table.insert(list, {
                        obj = obj,
                        part = part,
                        dist = dist,
                        name = obj.Name
                    })
                end
            end
        end
    end

    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end


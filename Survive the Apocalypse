    Callback = function(v) maxDistance = v end
})

Main:Slider({
    Title = "Delay al abrir",
    Value = { Min = 0.2, Max = 2, Default = 0.6 },
    Callback = function(v) openDelay = v end
})

Main:Paragraph({
    Title = "Cómo funciona",
    Desc = "El script busca cajas/crates cercanos, camina hacia ellos y intenta abrirlos (ProximityPrompt / ClickDetector / Touch). Los items deberían ir a tu mochila automáticamente si el juego lo permite."
})

task.spawn(function()
    while true do
        if autoFarm and RootPart and Humanoid and Humanoid.Health > 0 then
            local crates = getNearbyCrates()
            if #crates > 0 then
                local target = crates[1]
                local part = target.part

                -- Moverse hacia la caja
                Humanoid.WalkSpeed = farmSpeed
                Humanoid:MoveTo(part.Position)

                -- Si está cerca, intentar abrir
                if target.dist < 12 then
                    tryOpen(target.obj)
                    task.wait(openDelay)
                else
                    task.wait(0.25)
                end
            else
                -- No hay cajas cerca, espera un poco
                task.wait(1)
            end
        else
            task.wait(0.4)
        end
    end
end)

